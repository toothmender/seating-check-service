{
 "source": "Scan Body X-ray Examples (Rodrigo Bravo, last updated Dec 3, 2025)",
 "seating_criteria": {
  "fully_seated": "Scan body flush with implant platform. Exception: Zimmer TSV often shows an apparent gap due to the implant bevel; seated if edges touch. PEEK scan bodies show poorly on x-ray; use titanium base or screw to verify; get a second opinion if unsure.",
  "slightly_lifted": "Any space between scan body and implant is suspicious. Usually engaging but not fully seated (bone, hard tissue, leaning on tooth). Single unit: possible open occlusion. Bridge: refab.",
  "lifted_or_lifted_rotated": "Usually screwed in without being properly seated, or scan body does not belong to that implant; also bone, hard tissue, or leaning on tooth.",
  "incorrect_scan_body": "A larger or smaller scan body can indicate wrong platform or system. Get a second opinion if unsure."
 },
 "notes": [
  "TruAbutment only carries the Legacy 3.0 platform scan body for Implant Direct. Zimmer TSV 5.7 is compatible with Implant Direct Legacy 5.7."
 ],
